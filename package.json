{
  "name": "@entrolytics/cli",
  "version": "2.3.1",
  "description": "CLI for Entrolytics - First-party growth analytics for the edge",
  "keywords": [
    "analytics",
    "cli",
    "entrolytics",
    "tracking",
    "web-analytics"
  ],
  "homepage": "https://entrolytics.click",
  "bugs": {
    "url": "https://github.com/entrolytics/cli/issues"
  },
  "license": "MIT",
  "author": "Entrolytics <hey@entrolytics.click>",
  "repository": {
    "type": "git",
    "url": "https://github.com/entrolytics/cli",
    "directory": "entro-cli"
  },
  "bin": {
    "entro-ng": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "dev": "vp pack --watch",
    "lint": "vp lint --fix . && vp fmt --write .",
    "lint:fix-unsafe": "vp lint -f stylish --import-plugin --type-aware --type-check --vitest-plugin --node-plugin --fix --fix-suggestions --fix-dangerously src/",
    "prepublishOnly": "vp run build",
    "test": "vp test run",
    "test:watch": "vp test",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@entrolytics/shared": "2.4.1",
    "@entrolytics/trpc-client": "2.3.0",
    "@trpc/client": "^11.17.0",
    "chalk": "^5.6.2",
    "cli-table3": "^0.6.5",
    "commander": "^15.0.0",
    "conf": "^15.1.0",
    "open": "^11.0.0",
    "ora": "^9.4.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/ws": "^8.18.1",
    "typescript": "^6.0.3",
    "vite": "catalog:",
    "vite-plus": "^0.1.23",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24.x"
  },
  "packageManager": "pnpm@11.5.0"
}
