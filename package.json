{
  "name": "@entrolytics/cli",
  "version": "3.0.6",
  "description": "CLI for Entrolytics - First-party growth analytics for the edge",
  "keywords": [
    "analytics",
    "cli",
    "entrolytics",
    "tracking",
    "web-analytics"
  ],
  "homepage": "https://entrolytics.dev",
  "bugs": {
    "url": "https://github.com/entrolytics/cli/issues"
  },
  "license": "MIT",
  "author": "Entrolytics <hey@entrolytics.dev>",
  "repository": {
    "type": "git",
    "url": "https://github.com/entrolytics/cli",
    "directory": "entro-cli"
  },
  "bin": {
    "entro-ng": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "check": "tsc --noEmit",
    "dev": "tsdown --watch",
    "lint": "oxlint --fix . && oxfmt --write .",
    "lint:fix-unsafe": "oxlint -f stylish --import-plugin --type-aware --type-check --vitest-plugin --node-plugin --fix --fix-suggestions --fix-dangerously src/",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@entrolytics/shared": "^3.2.2",
    "@entrolytics/trpc-client": "^4.0.2",
    "@trpc/client": "^11.32.2",
    "chalk": "^6.0.1",
    "cli-table3": "^0.6.5",
    "commander": "^15.1.0",
    "conf": "^16.0.0",
    "open": "^11.0.4",
    "ora": "^10.0.0",
    "ws": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.11",
    "@types/ws": "^8.18.2",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "tsdown": "^0.23.7",
    "typescript": "next",
    "vitest": "^5.1.2"
  },
  "engines": {
    "node": ">=24.22.3"
  },
  "packageManager": "pnpm@12.24.0"
}
